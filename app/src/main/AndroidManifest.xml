<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="Vehicle Sensor Probe"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".AccelerometerProbeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CombinedCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RealDashTestActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RealDashLiveActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <service
            android:name=".RealDashTestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".RealDashLiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".CombinedCaptureService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
